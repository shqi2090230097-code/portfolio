---
import { tokenCSS } from '../design/tokens.mjs';
import '../styles/admin.css';
interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} · Portfolio Admin</title><style is:inline set:html={tokenCSS}/></head>
<body class="admin-body"><header class="admin-topbar"><a href="/admin" class="admin-brand">PORTFOLIO ADMIN</a><nav><a href="/" target="_blank">查看网站 ↗</a><button type="button" data-admin-signout hidden>退出登录</button></nav></header><main class="admin-main"><slot /></main></body></html>

