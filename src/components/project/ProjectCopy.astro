---
interface Props { eyebrow?: string; heading?: string; body: string[]; }
const { eyebrow, heading, body } = Astro.props;
---
<div class="detail-copy">
  {eyebrow && <p class="detail-label">{eyebrow}</p>}
  {heading && <h2 data-reveal>{heading}</h2>}
  {body.map(paragraph => <p>{paragraph}</p>)}
</div>
